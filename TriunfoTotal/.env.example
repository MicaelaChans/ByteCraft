# Copiar como .env y cambiar TODAS las contraseñas (mínimo 12 caracteres).
# El archivo .env NUNCA se sube a git (está en .gitignore).
# Generar una clave segura:  openssl rand -base64 18

DB_ROOT_PASS=cambiar_root_xxxxxxxx
APP_DB_PASS=cambiar_app_xxxxxxxxx
BACKUP_DB_PASS=cambiar_backup_xxxxxx
REPORTES_DB_PASS=cambiar_reportes_xxxx
DBA_DB_PASS=

# Nombre del servidor (dominio o IP) y puertos publicados
SERVIDOR_NOMBRE=localhost
HTTP_PUERTO=80
HTTPS_PUERTO=443

# Orígenes extra permitidos por CORS (separados por coma). Vacío = solo el propio sitio.
CORS_ORIGENES=

# ---------------------------------------------------------------------
# Correo: verificación de email al registrarse
#   CORREO_MODO = ninguno -> sin verificación (por defecto; sirve sin internet)
#               = smtp    -> envía los mails por Gmail (necesita SMTP_CLAVE)
#               = archivo -> guarda los mails en una carpeta (solo para pruebas)
# SMTP_CLAVE es una "contraseña de aplicación" de Google (16 letras, sin espacios),
# NO la contraseña normal de la cuenta. Ver docs/manual_tecnico.md.
CORREO_MODO=ninguno
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=bytecraftsoftware.2026@gmail.com
SMTP_CLAVE=
SMTP_NOMBRE=TriunfoTotal
# Dirección pública de la página para el link del mail (vacío = se detecta sola)
APP_URL=
# Rechazar dominios de email que no reciben correo (registro MX)
VALIDAR_DOMINIO_EMAIL=true
